# Mercury dashboard API token for the API-token org. Include the secret-token: prefix.
# Never commit the real value. In Cursor: Plugins → Configure.
MERCURY_API_TOKEN=secret-token:mercury_REPLACE_ME

# Grok Bot box secrets launcher only: mapped onto MERCURY_API_TOKEN.
# The stdio server itself reads MERCURY_API_TOKEN only.
# OFORICA_MERCURY_API_TOKEN=

# Spend tools stay in tools/list. Execute refuses until this is 1 / true / yes / on
# and Jim has explicitly greened spend.
# MERCURY_OPS_ALLOW_SPEND=1

# Optional. Defaults to https://api.mercury.com/api/v1
# MERCURY_API_BASE_URL=https://api.mercury.com/api/v1
