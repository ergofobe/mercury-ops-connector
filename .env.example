# Mercury dashboard API token (Oforica). Include the secret-token: prefix.
# Never commit the real value. Set it in Cursor → Plugins → Configure.
MERCURY_API_TOKEN=secret-token:mercury_REPLACE_ME

# Grok Bot / Ori only: the launcher maps this to MERCURY_API_TOKEN.
# The stdio server itself reads MERCURY_API_TOKEN only.
# OFORICA_MERCURY_API_TOKEN=

# Optional. Defaults to https://api.mercury.com/api/v1
# MERCURY_API_BASE_URL=https://api.mercury.com/api/v1
